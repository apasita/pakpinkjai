# ── Pak Pink Jai Environment Variables ──
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pakpinkjai
# Production (Azure Cosmos DB):
# MONGODB_URI=mongodb://pakpinkjai:PASSWORD@pakpinkjai.mongo.cosmos.azure.com:10255/pakpinkjai?ssl=true

# JWT Secret (ใช้ random string ยาวๆ)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Encryption key for sensitive data (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
